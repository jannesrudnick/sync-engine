{
  "name": "@jannesrudnick/sync-engine",
  "version": "0.3.0",
  "description": "Local-first sync engine after Linear's, for React + Supabase.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./schema.sql": "./schema.sql"
  },
  "files": ["dist", "schema.sql"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.0.0"
  }
}
